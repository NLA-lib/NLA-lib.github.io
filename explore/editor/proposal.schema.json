{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nla-lib.org/schemas/editor-proposal-v1.json",
  "title": "NLA-lib local editorial proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "explanation",
    "changes"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "explanation": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/pageChange"
          },
          {
            "$ref": "#/$defs/statementChange"
          }
        ]
      }
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "locator"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 2000
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "locator": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "pageChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "id",
        "base_revision",
        "fields"
      ],
      "properties": {
        "operation": {
          "const": "update_page"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "base_revision": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "document_markdown": {
              "type": "string",
              "maxLength": 120000
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "summary": {
              "type": "string",
              "maxLength": 120000
            },
            "body_markdown": {
              "type": "string",
              "maxLength": 120000
            }
          }
        }
      }
    },
    "statementChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "id",
        "base_revision",
        "fields"
      ],
      "properties": {
        "operation": {
          "enum": [
            "update_statement",
            "create_statement"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "base_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body_markdown": {
              "type": "string",
              "maxLength": 120000
            },
            "statement_kind": {
              "enum": [
                "result",
                "conjecture",
                "definition"
              ]
            },
            "proofs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/proof"
              }
            },
            "references": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "locator"
                ],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "locator": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
